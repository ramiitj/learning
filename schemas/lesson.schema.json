{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "required": ["id", "schemaVersion", "version", "status", "meta", "stages", "checks", "strings", "localeStatus"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "schemaVersion": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "in-review", "awaiting-creator", "published", "archived"] },
    "meta": {
      "type": "object",
      "required": ["titleKey", "subject", "concepts", "objectives", "prerequisites", "audiences", "estimatedMinutes"],
      "additionalProperties": false,
      "properties": {
        "titleKey": { "type": "string" },
        "subtitleKey": { "type": "string" },
        "subject": { "type": "string" },
        "course": { "type": "string" },
        "module": { "type": "string" },
        "issue": { "type": "string" },
        "concepts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "objectives": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["id", "textKey"], "properties": { "id": { "type": "string" }, "textKey": { "type": "string" } }, "additionalProperties": false }
        },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "audiences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "curriculumTags": { "type": "array", "items": { "type": "string" } },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "teacherGuide": { "type": "string" },
        "parentPage": { "type": "string" },
        "provenance": { "type": "string", "description": "How the lesson was made, e.g. 'agent pipeline v1, creator-reviewed'" }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["stage", "blocks"],
        "additionalProperties": false,
        "properties": {
          "stage": { "enum": ["hook", "predict", "manipulate", "explain", "break-it", "transfer-reflect"] },
          "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
        }
      }
    },
    "checks": {
      "type": "object",
      "required": ["pre", "post"],
      "additionalProperties": false,
      "properties": {
        "pre": { "type": "array", "items": { "$ref": "#/$defs/checkItem" }, "minItems": 1 },
        "post": { "type": "array", "items": { "$ref": "#/$defs/checkItem" }, "minItems": 1 }
      }
    },
    "strings": {
      "type": "object",
      "description": "Locale code -> (string key -> text). ICU message format.",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } }
    },
    "localeStatus": {
      "type": "object",
      "description": "Locale code -> review status. Only human reviewers set 'reviewed' for non-English locales.",
      "additionalProperties": { "enum": ["missing", "draft", "reviewed"] }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["id", "type", "componentVersion", "config"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "description": "A component registered in the plugin registry" },
        "componentVersion": { "type": "string" },
        "config": { "type": "object", "description": "Validated against the component's own contract" },
        "depth": { "enum": ["core", "deeper", "deepest"], "default": "core" },
        "classroom": { "type": "object", "description": "Overrides for classroom mode" },
        "detours": { "type": "array", "items": { "type": "string" }, "description": "Concept or detour lesson ids offered here" },
        "glossaryTerms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checkItem": {
      "type": "object",
      "required": ["id", "objective", "promptKey", "options", "answer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "objective": { "type": "string" },
        "promptKey": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "answer": { "type": "string" },
        "feedbackKey": { "type": "string" }
      }
    },
    "analogyConfig": {
      "type": "object",
      "description": "Contract for the 'analogy' component config",
      "required": ["concept", "sourceKey", "mappings", "breakPointKey"],
      "properties": {
        "bankId": { "type": "string" },
        "concept": { "type": "string" },
        "sourceKey": { "type": "string" },
        "mappings": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["sourceKey", "targetKey"], "properties": { "sourceKey": { "type": "string" }, "targetKey": { "type": "string" } } }
        },
        "breakPointKey": { "type": "string" },
        "fading": { "type": "array", "items": { "type": "string" } },
        "audienceVariants": { "type": "object" },
        "localeVariants": { "type": "object" }
      }
    }
  }
}
