{
  "name": "learning-magazine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lm/web dev",
    "build": "pnpm --filter @lm/web build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @lm/web test:e2e",
    "validate:content": "tsx scripts/validate-content.ts",
    "pack:lessons": "tsx scripts/ops/build-pack.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@lm/primitives": "workspace:*",
    "@lm/schema": "workspace:*",
    "@next/eslint-plugin-next": "16.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "@lm/validation": "workspace:*",
    "@lm/catalogue": "workspace:*"
  }
}
