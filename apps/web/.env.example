# Copy to .env.local for development. Never commit real values.
DATABASE_URI=postgres://lm:lm@localhost:5432/lm
# 32+ random characters: openssl rand -hex 32
PAYLOAD_SECRET=
# The site's public origin; passkeys are bound to its hostname.
APP_ORIGIN=http://localhost:3000
# One-time token to create the creator account and its first passkey. Remove after setup.
CREATOR_SETUP_TOKEN=
# Agent pipeline (Phase 4). Leave empty to run without agents.
ANTHROPIC_API_KEY=
# Secret the scheduler sends to /api/cron/* (Vercel Cron sets this header).
CRON_SECRET=

# Reliability (Phase 6). Optional: a webhook (email or Slack relay) that receives a short
# text, with no learner data, when a new error appears or errors spike (docs/runbooks/incident-response.md).
ALERT_WEBHOOK_URL=
# Set by Vercel automatically; recorded as the "release" on each error.
VERCEL_GIT_COMMIT_SHA=
# Backups run in GitHub Actions, not in the app. Repository secrets: BACKUP_DATABASE_URL,
# BACKUP_AGE_RECIPIENT, BACKUP_AGE_IDENTITY (see docs/runbooks/backup-restore.md).

# Offline lesson packs (scripts/ops/build-pack.ts, `pnpm pack:lessons`). Never set these for a normal build or on Vercel.
# LM_PACK=1 is set by the pack build only: it switches next build to output "standalone".
LM_PACK=
# In an unpacked pack: the address the server binds to (default 0.0.0.0, every network interface, so the
# school network can join). Set 127.0.0.1 to keep it to the one computer. PORT (default 8080) picks the port.
LM_PACK_HOST=

# LTI 1.3 and xAPI (Phase 6). OFF by default: they change how data leaves the platform and await the
# creator's decision (docs/proposals/lti-xapi.md). Set to 1 only after that decision.
LTI_ENABLED=
# Also requires LTI_ENABLED=1, and an LRS registered on the launching platform in the console.
XAPI_ENABLED=
# The tool's private signing key (PKCS#8 PEM, newlines may be written as \n). Only its public half is
# served, at /api/lti/jwks. Generate it outside the repository and store it in the host's secret store:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out lti-private.pem
# Never commit the .pem file.
LTI_PRIVATE_KEY=
